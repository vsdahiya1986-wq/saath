# Copy this file to .env.local and fill in real values.
# The app runs fully offline without any of these — they only enable
# Bhashini-generated audio (build step) and Supabase sync (optional).

# Bhashini (scripts/generate-audio.mjs — build-time only, never shipped to the client)
# Only BHASHINI_API_KEY is actually used — a dashboard-issued inference key
# from bhashini.gov.in, tied to whichever TTS/translation tasks you attached
# to that pipeline in the dashboard UI. USER_ID/PIPELINE_ID below are for the
# separate raw-ULCA auth flow (meity-auth.ulcacontrib.org service discovery)
# and are unused by this script; kept here only if you switch flows later.
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_PIPELINE_ID=

# Supabase (src/lib/sync.ts — public/anon values, safe for the client bundle)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Twilio (optional, online-fallback alert calls — not yet wired up)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
